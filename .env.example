# Copiar este archivo como ".env" y completar con los valores reales.
# NUNCA subir el archivo ".env" real al repositorio.

# Cadena de conexion a PostgreSQL (Supabase Cloud), formato Npgsql:
# Host=<pooler-host>;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true
SUPABASE_DB_CONNECTION=

SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opcionales (notificaciones por correo / asistente IA). Pueden dejarse vacios
# para el flujo basico de login + mercado + billetera.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
GROQ_API_KEY=
