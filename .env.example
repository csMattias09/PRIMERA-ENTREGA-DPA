# Copiar este archivo como ".env" y completar con los valores reales.
# NUNCA subir el archivo ".env" real al repositorio.

# Cadena de conexion a PostgreSQL (Supabase Cloud), formato Npgsql:
# Host=<pooler-host>;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true
#
# IMPORTANTE: usar el "Session pooler" de Supabase (puerto 5432), NO el "Transaction pooler"
# (puerto 6543). Con Npgsql/EF Core, el Transaction pooler (PgBouncer en modo transaction)
# provoca timeouts/cuelgues en consultas reales aunque el health check basico funcione.
# Tampoco usar el host directo "db.<project-ref>.supabase.co": desde 2024 solo resuelve por
# IPv6 y Docker Desktop en Windows no tiene salida IPv6 por defecto.
SUPABASE_DB_CONNECTION=

SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opcionales (notificaciones por correo / asistente IA). Pueden dejarse vacios
# para el flujo basico de login + mercado + billetera.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
GROQ_API_KEY=
